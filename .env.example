# Node Environment
NODE_ENV="development"
PORT="3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LLM Configuration
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.8-flash"

# Session Security
SESSION_SECRET="replace-with-a-secure-random-secret-in-production"

# Database: Optional MongoDB Connection URI
# When omitted, the system falls back to the in-memory document store.
MONGODB_URI="mongodb://localhost:27017/prepkit"

# Security: Set to 'true' to permit crawling of local addresses in evaluator/testing mode
ALLOW_LOCAL_URLS="false"

# APP_URL: Hosted URL
APP_URL="MY_APP_URL"
